{
  "name": "lifevault-bbms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "seed": "node backend/seed.js"
  },
  "description": "LifeVault - Next-Generation Blood Bank Management & Life Vault Telemetry System",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyxens/GitBlameUs.git"
  },
  "keywords": [
    "blood-bank",
    "telemetry",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
