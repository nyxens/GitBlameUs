{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "typeRoots": [],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ui/*": ["src/components/ui/*"],
      "@ui": ["src/components/ui"],
      "@layout/*": ["src/components/layout/*"],
      "@layout": ["src/components/layout"],
      "@modals/*": ["src/components/modals/*"],
      "@modals": ["src/components/modals"],
      "@pages/*": ["src/pages/*"],
      "@pages": ["src/pages"],
      "@services/*": ["src/services/*"],
      "@services": ["src/services"],
      "@hooks/*": ["src/hooks/*"],
      "@hooks": ["src/hooks"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils"],
      "@backend/*": ["backend/*"]
    }
  },
  "include": ["src/**/*", "backend/**/*"],
  "exclude": ["node_modules", "dist"]
}
